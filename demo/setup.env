# Shared env for the RBAC sync-server demo.
# Source me from any shell that needs to talk to the demo server:
#   source setup.env

# HS256 signing secret. Both the JWT verifier inside the server AND the
# mint_jwt helper that creates client tokens read this value. Keep them
# identical or every request 401s.
export TURSO_SYNC_JWT_HS_SECRET="demo-shared-secret-do-not-use-in-prod"

# `kid` (key identifier) embedded in the JWT header. The verifier indexes
# its key table on (algorithm, kid). Single-key demo so this never varies.
export TURSO_SYNC_JWT_KID="hs1"

# Allow-listed issuers. Tokens whose `iss` claim isn't here are rejected.
# Required — closes the cross-issuer sub collision class of attacks.
export TURSO_SYNC_JWT_ISSUERS="https://idp.demo.local"

# Mode A (default) = roles come from `_turso_rbac_role_assignments`, NOT
# from the JWT claims. The JWT only proves identity. Set to "jwt" to use
# Mode B if you want to demo that path.
export TURSO_SYNC_JWT_ROLE_SOURCE="table"

# Clock-skew leeway for exp/nbf validation. 60s is loose enough for demo
# clocks; production usually sets 30s or tighter.
export TURSO_SYNC_JWT_LEEWAY_SECS="60"

# Where the sync server listens.
export TURSO_SYNC_SERVER_ADDR="127.0.0.1:8080"

# Path to the CLOUD DB file — the sync server's authoritative copy.
# Named `cloud_demo.db` so it's distinguishable from the per-client
# replica files (client_alice.db, client_bob.db) that scenario 8 creates.
# tour.sh deletes this at the start of every run so we always begin
# from a clean state (empty grants table, no admin).
export TURSO_DEMO_DB="cloud_demo.db"

# Pre-warm flag is intentionally LEFT UNSET so the tour demonstrates TOFU.
# To skip TOFU for the demo, set:
#   export TURSO_SYNC_INITIAL_ADMIN_ISS_SUB="https://idp.demo.local:operator"
